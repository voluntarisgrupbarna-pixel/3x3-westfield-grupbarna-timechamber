# Apps Script webhook (rep inscripcions, escriu a Sheet/Fillout/GitHub backup)
VITE_GOOGLE_SHEET_WEBHOOK=https://script.google.com/macros/s/...

# JotForm legacy (no s'usa al flux nou, però es manté per compatibilitat)
VITE_JOTFORM_API_KEY=
VITE_JOTFORM_FORM_ID=
VITE_JOTFORM_BASE_URL=

# Base URL per a links compartits (ex: https://cbgrupbarna-3x3timechamber.com)
VITE_SHARE_BASE=

# Pàgina staff de cerca d'inscripcions
#   Repo on Apps Script desa el JSON backup (privat)
VITE_BACKUP_REPO=voluntarisgrupbarna-pixel/3x3-westfield-grupbarna-timechamber
VITE_BACKUP_PATH=data/inscripcions-2026.json
VITE_BACKUP_BRANCH=main
#   SHA-256 hex del password staff. Genera amb:
#     echo -n "elteupassword" | shasum -a 256
VITE_STAFF_PASSWORD_HASH=
